#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE_L		0
#define SCROLL_L 	1
#define BT_L 		2


/ {
    behaviors {
        mid: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp MB3>, <&to BT_L>, <&out OUT_USB>;
        };
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
/* MOUSE
 * -----------------
 * |       |   MMB   | 
 * | LMB   |   RMB   |
 */
                        bindings = <
						&mid
				&mkp MB1        &mkp MB2
                        >;
                };
	
                scroll_layer {
/* SCROLL
 * -----------------
 * |       |   MMB   | 
 * | LMB   |   RMB   |
 */
                        bindings = <
						&mid
				&mkp MB1        &mkp MB2
                        >;
                };
                default_layer {
/* BlueTooth setup layer
 * -----------------
 * |       |   MMB   | 
 * | LMB   |   RMB   |
 */
                        bindings = <
						&mid
				&bt BT_CLR      &out  OUT_BLE
                        >;
                };
        };
};
